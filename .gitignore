### Visual Studio / C# project ignore file
# Source: https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

## Build and Debugging
######################################
# Build results
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
[Oo]ut/
build/
Build/
*.suo
*.user
*.userosscache
*.sln.docstates

# VS Code directory for workspace settings
.vscode/

## Packages and Dependencies
######################################
# NuGet packages
*.nupkg
# The directory for NuGet packages (usually restored by 'dotnet restore')
[Pp]ackages/
# Publish directory
publish/

# Rider's private solution user files
.idea/

## Testing
######################################
TestResults/
.trx

## Logs and Traces
######################################
*.log
*.pfx
*.vspscc
*.vssscc
*.bak
*.vsw
*Cache*
ClientBin/
[Ss]ource/[Cc]ontrol/
[Bb]uild[Ee]ngine/
InstallSource/
[Mm]isc/
[._]*

## Visual Studio specific files
######################################
# Visual Studio project files (except .sln and .csproj)
*.vsp
*.vsa
*.vssscc

# User files and IDE generated files
*.resharper
*.dotSettings
*.pidb
*.booproj
*.sln.ide
*.cache
*.sdf
*.opensdf

# Resharper/dotCover/dotTrace files
*.dotCover
*.dotCover.user
*.dotTrace
*.dotTrace.user

## Cross-Platform / .NET Core Specific
######################################
# Core artifacts (often used in dotnet publish)
runtimes/

# Linux/macOS style dot files
.DS_Store

# Temporary files created by ASP.NET Core
**/*.tmp
**/*.temp

# Dependency Manager files
bower_components/
node_modules/